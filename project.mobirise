            ".panel-group": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "20px",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".content-wrap": {
                "&:nth-child(2)": {
                  "@media (max-width: 992px)": {
                    "margin-top": "20px"
                  }
                }
              },
              ".card": {
                "position": "relative",
                "padding": "0",
                "margin-top": "20px",
                "background-color": "@cardBg",
                "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
                "transition": "all 0.3s ease-in-out",
                "&:first-child": {
                  "margin-top": "0"
                },
                "&:hover": {
                  "transform": "translateY(-2px)"
                },
                ".card-header": {
                  "background-color": "transparent",
                  "border": "none",
                  "border-radius": "0",
                  "padding": "0",
                  ".panel-title": {
                    "display": "flex",
                    "justify-content": "space-between",
                    "align-items": "center",
                    "width": "100%",
                    "padding": "18px 20px",
                    ".panel-title-edit": {
                      "transition": "all 0.3s ease-in-out",
                      "margin-bottom": "0"
                    },
                    ".icon-wrapper": {
                      "width": "16px",
                      "height": "16px",
                      "min-width": "16px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "margin-left": "20px",
                      "transition": "all 0.3s ease-in-out",
                      ".mbr-iconfont": {
                        "font-size": "14px",
                        "transition": "all 0.3s ease-in-out",
                        "color": "@icon"
                      }
                    },
                    "&:not(.collapsed)": {
                      ".icon-wrapper": {
                        ".mbr-iconfont": {
                          "color": "@activeColor",
                          "transform": "rotate(-180deg)"
                        }
                      },
                      ".panel-title-edit": {
                        "color": "@activeColor"
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "margin": "0 18px 20px",
                    ".panel-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".panel-title-edit": {
              "color": "#0f172a"
            },
            ".panel-text": {
              "color": "#475569"
            },
            ".mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_name": "list01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 launchm5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\" selected>8</option>\n        </select>\n        <header>Cards</header>\n        <input type=\"color\" title=\"Icon\" value=\"#475569\" name=\"icon\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#5480c1\" name=\"activeColor\">\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-question mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Commerce Guide\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Your Questions About High Watch</b></h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Find out how USCN High Watch works, who can apply and how our free community CCTV cameras and professional live monitoring help support safer public spaces.\n                            </p>\n                        </div>\n                    </div>\n                    <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                        <div class=\"content-wrap\">\n                            <div class=\"card\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>What is USCN High Watch?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            USCN High Watch is a free community safety CCTV programme operated by UK Safety Camera Network Ltd. We provide, install, own and maintain CCTV cameras at approved locations, helping monitor high streets and public spaces. Our control room operators can view live footage during operating hours, identify potential incidents and coordinate appropriate responses. The programme focuses on wider community safety rather than dedicated security for individual businesses.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Who can apply for USCN High Watch?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            Businesses, property owners and other suitable premises within our service areas can apply to host a High Watch camera. Each application is assessed individually, considering the location, potential community safety benefits, privacy requirements and available resources. Acceptance is not guaranteed.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Is USCN High Watch completely free?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            Yes. Approved High Watch hosts receive CCTV equipment, installation, maintenance and live monitoring free of charge. The cameras remain the property of UK Safety Camera Network Ltd. Hosts may be required to provide a suitable mounting location, electricity and internet connectivity under the hosting agreement.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 6\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Who owns and maintains the CCTV cameras?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            All High Watch cameras are owned and operated by UK Safety Camera Network Ltd. We are responsible for their maintenance, software updates, security and replacement when required. Participating businesses do not need to purchase or independently maintain the camera equipment.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"content-wrap\">\n                            <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Are High Watch cameras monitored 24 hours a day?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            No. High Watch cameras are monitored by our human operators during USCN Live's published operating hours. Outside these hours, cameras may continue recording in accordance with their configured retention and recording arrangements. Live monitoring does not guarantee that every incident will be detected or prevented.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Can High Watch monitor my existing CCTV cameras?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            No. High Watch is designed around community safety cameras supplied, owned and operated by USCN. If you already have CCTV cameras and would like professional live monitoring, our standard paid USCN Live service may be suitable. Eligible public bodies, charities and not-for-profit organisations may also be able to apply through our separate USCN Live Smartwatch programme.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingSeven\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse7\" aria-expanded=\"false\" aria-controls=\"collapse7\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>What happens if your operators detect suspicious activity?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse7\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSeven\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            If our operators identify a potential incident, they assess the situation and take appropriate action. Depending on the circumstances, this may include contacting the police, emergency services or other relevant contacts. Our aim is to support timely responses to incidents affecting public and community safety.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"card\" mbr-if=\"cardAmount > 7\">\n                                <div class=\"card-header\" role=\"tab\" id=\"headingEight\">\n                                    <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse8\" aria-expanded=\"false\" aria-controls=\"collapse8\">\n                                        <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>What happens if my High Watch application is unsuccessful?</b></h4>\n                                        <div class=\"icon-wrapper\">\n                                            <span class=\"sign mbr-iconfont mobi-mbri-arrow-down mobi-mbri\"></span>\n                                        </div>\n                                    </a>\n                                </div>\n                                <div id=\"collapse8\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingEight\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                    <div class=\"panel-body\">\n                                        <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text, .panel-body\">\n                                            Not every location can be accepted into High Watch. If we're unable to provide live monitoring, we may consider your location for our standard Host a Camera programme, which provides free USCN-owned community CCTV without routine live monitoring. Any alternative remains subject to eligibility, location suitability and available resources.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4MktOjYLU",
          "_anchor": "list01-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "padding-bottom": "(@paddingBottom * 1rem)",
              "& when (@showBorder)": {
                "padding-left": "20px",
                "padding-right": "20px",
                "border-bottom": "1px solid @border",
                "@media (max-width: 425px)": {
                  "padding-left": "0",
                  "padding-right": "0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px solid @border",
                  "pointer-events": "none",
                  "@media (max-width: 425px)": {
                    "display": "none"
                  }
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "right": "0"
                }
              },
              ".title-wrapper": {
                "margin-bottom": "40px",
                ".label-wrapper": {
                  "margin-bottom": "16px",
                  ".label-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "padding": "7px 18px",
                    "box-shadow": "inset 0 10px 8px 0 @shadow_1, inset 0 -5px 10px -8px @shadow_2, 0 10px 10px -8px @shadow_2",
                    "background-color": "@labelBg",
                    ".iconfont-wrapper": {
                      "display": "inline-flex",
                      ".mbr-iconfont": {
                        "font-size": "18px",
                        "display": "inline-flex",
                        "margin-right": "8px"
                      }
                    },
                    ".mbr-label": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "16px"
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "50%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -10px",
              ".card": {
                "padding": "0 10px"
              }
            },
            ".card-wrapper": {
              "padding": "24px",
              "background-color": "@cardBg",
              "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
              "overflow": "hidden",
              "@media (max-width: 992px)": {
                "padding": "20px",
                "margin-bottom": "20px"
              },
              ".title-wrap": {
                "display": "flex",
                "gap": "16px",
                "margin-bottom": "32px",
                "@media (max-width: 992px)": {
                  "display": "block",
                  "margin-bottom": "20px"
                },
                ".icon-wrapper": {
                  "width": "52px",
                  "min-width": "52px",
                  "@media (max-width: 992px)": {
                    "margin-right": "0",
                    "margin-bottom": "16px"
                  },
                  ".mbr-iconfont": {
                    "width": "52px",
                    "height": "52px",
                    "min-width": "52px",
                    "font-size": "32px",
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "background-color": "@iconBg",
                    "box-shadow": "inset 0 2px 10px -2px @iconShadow, 0 10px 10px -2px @iconShadow"
                  }
                },
                ".card-box": {
                  "width": "100%",
                  ".item-title": {
                    "margin-bottom": "0"
                  },
                  ".item-text": {
                    "margin-bottom": "0"
                  }
                }
              },
              ".form-wrap": {
                ".dragArea.row": {
                  "position": "relative",
                  "z-index": "1",
                  "margin": "0 -9.6px",
                  ".form-group": {
                    "margin-bottom": "0 !important",
                    ".form-control-label": {
                      "margin-bottom": "8px"
                    },
                    ".form-control": {
                      "padding": "6px 12px",
                      "background-color": "@inputBg",
                      "border": "1px solid @inputBorder !important",
                      "box-shadow": "inset 0 1px 3px -1px @inputBorder, inset 0 5px 13px -2px @inputBorder",
                      "margin-bottom": "32px",
                      "min-height": "40px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "20px"
                      },
                      "&::placeholder": {
                        "color": "@inputColor"
                      },
                      "&:hover, &:focus": {
                        "border": "1px solid @activeColor !important",
                        "box-shadow": "inset 0 1px 10px -5px @activeColor, 1px 10px 20px -10px @activeColor",
                        "background-color": "@cardBg"
                      }
                    },
                    "textarea": {
                      "min-height": "100px"
                    },
                    ".form-check": {
                      "padding-left": "2.1em",
                      ".form-check-input": {
                        "background-color": "@inputBorder",
                        "border-color": "@inputBorder"
                      }
                    }
                  },
                  ".mbr-section-btn": {
                    "width": "100%",
                    ".btn": {
                      "width": "100%",
                      "margin-bottom": "0",
                      "margin-right": "0",
                      "margin-top": "0"
                    }
                  }
                }
              }
            },
            ".image-wrapper": {
              "position": "relative",
              "height": "100%",
              "width": "100%",
              "@media (max-width: 992px)": {
                "height": "320px"
              },
              "img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#0f172a"
            },
            ".item-text": {
              "color": "#475569"
            },
            "label": {
              "color": "#475569"
            }
          },
          "_name": "form01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 launchm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <header>Form</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showCardIcon\" checked>\n        <input type=\"color\" title=\"Icon Bg\" value=\"#5480c1\" name=\"iconBg\" condition=\"showCardIcon\" selected>\n        <input type=\"color\" title=\"Icon Shadow\" value=\"#cccccc\" name=\"iconShadow\" condition=\"showCardIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\">\n        <input type=\"color\" title=\"Input Color\" value=\"#9ca3af\" name=\"inputColor\" selected>\n        <input type=\"color\" title=\"Input BG\" value=\"#f5f5f5\" name=\"inputBg\" selected>\n        <input type=\"color\" title=\"Input Border\" value=\"#e1e7ed\" name=\"inputBorder\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#5480c1\" name=\"activeColor\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-contact-form mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Contact Advisor\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            Start Your Business\n                        </h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Ready to improve your operations, strengthen your strategy, or unlock new growth\n                                opportunities?\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6 card\">\n                            <div class=\"card-wrapper\">\n                                <div class=\"title-wrap\" mbr-if=\"showCardIcon || showCardTitle ||showCardText\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                        <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-user mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>\n                                            Apply Here</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                            Build your next step.\n                                        </p>\n                                    </div>\n                                </div>\n                                <div mbr-form class=\"mbr-form form-wrap\">\n                                    <form action=\"scanlon1000@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"scanlon1000@gmail.com\">\n                                        <div class=\"row\">\n                                            <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n                                            <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem!\n                                            </div>\n                                        </div>\n                                        <div class=\"dragArea row\">\n                                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"name\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Name</label>\n                                                <input type=\"text\" name=\"name\" placeholder=\"John Smith\" data-form-field=\"name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                            </div>\n                                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"email1\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Email</label>\n                                                <input type=\"email\" name=\"email1\" placeholder=\"your@email.com\" data-form-field=\"email1\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                            </div>\n                                            <div data-for=\"text\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"text\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Phone</label>\n                                                <input type=\"text\" name=\"text\" placeholder=\"07123456789\" data-form-field=\"text\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                            </div>\n                                            <div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"textarea\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Message</label>\n                                                <textarea name=\"textarea\" placeholder=\"Your Message\" data-form-field=\"textarea\" mbr-theme-style=\"display-4\" class=\"form-control\"></textarea>\n                                            </div>\n                                            <div class=\"col-md-auto col mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n                                                <a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"btn btn-black\"> Send Now </a>\n                                            </div>\n                                        </div>\n                                    </form>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 card\" mbr-if=\"showImage\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@THEME_PATH@/components/_images/launch/image1.jpg\" alt=\"Mobirise Website Builder\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4Mkt38Oxd",
          "_anchor": "form01-b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@showBorder)": {
              "border-top": "1px solid @border",
              "border-bottom": "1px solid @border",
              "margin-top": "-1px"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer"
            },
            "& when not (@spacing)": {
              ".grid-container": {
                "grid-row-gap": "0"
              },
              ".grid-container-1, .grid-container-2, .grid-container-3": {
                "gap": "0"
              }
            },
            "& when (@spacing)": {
              ".grid-container": {
                "grid-row-gap": "20px",
                "@media (max-width: 767px)": {
                  "grid-row-gap": "20px"
                }
              },
              ".grid-container-1, .grid-container-2, .grid-container-3": {
                "gap": "0 20px",
                "@media (max-width: 767px)": {
                  "gap": "0 20px"
                }
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "40px",
              "color": "#0f172a",
              "text-align": "center"
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".container, .container-fluid": {
              "overflow": "hidden"
            },
            ".grid-container": {
              "display": "grid",
              "transform": "translate3d(-3rem, 0, 0)",
              "width": "115vw",
              "grid-column-gap": "1rem"
            },
            ".grid-item": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when (@showShadow)": {
                "-webkit-mask-image": "linear-gradient(#000000 80%, transparent 95%)",
                "mask-image": "linear-gradient(#000000 80%, transparent 95%)"
              }
            },
            ".grid-item img": {
              "@media (max-width: 1440px)": {
                "height": "350px"
              },
              "@media (max-width: 1200px)": {
                "height": "300px"
              },
              "@media (max-width: 767px)": {
                "min-width": "35vw",
                "height": "250px"
              },
              "@media (max-width: 425px)": {
                "height": "140px"
              },
              "min-width": "30vw",
              "max-width": "100%",
              "height": "400px",
              "object-fit": "cover"
            },
            ".grid-container-1, .grid-container-2, .grid-container-3": {
              "display": "grid",
              "grid-template-columns": "repeat(4, 1fr)",
              "grid-auto-columns": "1fr",
              "grid-auto-flow": "column"
            },
            ".grid-container-1": {
              "align-items": "flex-end"
            },
            ".grid-container-2": {
              "align-items": "flex-start"
            }
          },
          "_name": "gallery02",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery02 launchm5\" group=\"Gallery & Slider\" plugins=\"scrollGallery\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" title=\"Reverse direction\" name=\"movingLeft\" checked>\n        <input type=\"checkbox\" title=\"Shadow\" name=\"showShadow\" checked>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\">\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" parallax name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#5480c1\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container-fluid gallery-wrapper\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 content-head\">\n                <div class=\"mbr-section-head\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                        Publish your site or preview it to see how the slider works in action.\n                    </h4>\n                </div>\n            </div>\n        </div>\n        <div class=\"grid-container\">\n            <div class=\"grid-container-3\" mbr-class=\"{'moving-left': movingLeft}\" style=\"transform: translate3d(-200px, 0px, 0px);\">\n                <div class=\"grid-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/ptzcam1-614x499.jpg\" alt=\"PTZ Camera\">\n                </div>\n                <div class=\"grid-item\">\n                  <img src=\"@PROJECT_PATH@/assets/images/20250726-1911280-614x346.jpg\" alt=\"Camera on wood post\">\n                </div>\n                <div class=\"grid-item\">\n                  <img src=\"@PROJECT_PATH@/assets/images/20261013-170117-672x374.jpg\" alt=\"Camera On Brick Wall\">\n                </div>\n                <div class=\"grid-item\">\n                  <img src=\"@PROJECT_PATH@/assets/images/screenshot-20260728-121339-gallery-613x345.jpg\" alt=\"House Cameras\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4Ml5ikfgz",
          "_anchor": "gallery02-g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "padding": "60px 60px 0 60px",
              "border-bottom-left-radius": "0 !important",
              "border-bottom-right-radius": "0 !important",
              "background-color": "@cardBg",
              "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, 1px 0 10px -5px @cardShadow_2",
              "overflow": "hidden",
              "margin-top": "-1px",
              "@media (max-width: 992px)": {
                "padding": "20px 20px 0 20px"
              },
              ".content-wrapper": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".title-wrapper": {
                  ".title-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "gap": "10px",
                    "flex-wrap": "wrap",
                    "margin-bottom": "12px",
                    ".logo-wrapper": {
                      "img": {
                        "width": "30px",
                        "height": "30px",
                        "min-width": "30px",
                        "object-fit": "cover"
                      }
                    },
                    ".mbr-section-title": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "80%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "10px"
                }
              },
              ".nav-wrapper": {
                "display": "grid",
                "grid-template-columns": "1fr 1fr 1fr",
                "gap": "20px",
                "margin-bottom": "60px",
                "@media (max-width: 1440px)": {
                  "grid-template-columns": "1fr 1fr"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                "@media (max-width: 768px)": {
                  "grid-template-columns": "1fr"
                },
                ".nav-wrap": {
                  ".mbr-list-title": {
                    "margin-bottom": "20px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "12px"
                    }
                  },
                  ".list": {
                    "padding": "0",
                    "margin": "0",
                    "list-style-type": "none",
                    "display": "flex",
                    "flex-direction": "column",
                    ".item-wrap": {
                      "position": "relative",
                      "margin-bottom": "16px",
                      "transition": "all 0.3s ease-in-out",
                      "display": "inline-flex",
                      "width": "fit-content",
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "bottom": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "1px",
                        "background-color": "@activeNav",
                        "opacity": "0",
                        "transition": "all 0.3s ease-in-out",
                        "transform": "translateY(-2px)"
                      },
                      "&:hover, &:focus": {
                        "color": "@activeNav",
                        "&::before": {
                          "opacity": "1",
                          "transform": "translateY(0)"
                        }
                      },
                      "&:last-child": {
                        "margin-bottom": "0"
                      },
                      "@media (max-width: 992px)": {
                        "margin-bottom": "8px",
                        "&:last-child": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                }
              },
              ".copy-wrap": {
                "position": "relative",
                "display": "flex",
                "justify-content": "center",
                "& when (@showCopy)": {
                  "padding": "20px 0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "top": "0",
                  "width": "1000%",
                  "height": "1px",
                  "background-color": "@border"
                },
                ".mbr-copy": {
                  "width": "100%",
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#0f172a"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569"
            },
            ".mbr-list-title": {
              "color": "#475569"
            },
            ".list": {
              "color": "#0f172a"
            },
            ".mbr-copy": {
              "color": "#0f172a"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 launchm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Navigation Title\" name=\"showNavTitle\" checked condition=\"showNav\">\n        <input type=\"color\" title=\"Active Color\" value=\"#5480c1\" name=\"activeNav\" condition=\"showNav\" selected>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"Container BG\" value=\"#fafafa\" name=\"cardBg\" selected>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/ptzcam1-1440x1171.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"card-wrapper\">\n                    <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6\" mbr-if=\"showLogo || showTitle || showText || showButtons\">\n                            <div class=\"content-wrapper\">\n                                <div class=\"title-wrapper\">\n                                    <div class=\"title-wrap\">\n                                        <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                            <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/copy20of20lwg-96x96.png\" alt=\"USCNLive Logo\">\n                                        </div>\n                                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .icon-wrapper\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b><a href=\"index.html\" class=\"text-black\">High Watch</a> &amp; <a href=\"https://smartwatch.uscnlive.com\" class=\"text-black\">USCN SMART WATCH</a></b><br><b>Part of <a href=\"https://www.uscnlive.com\" class=\"text-black\">USCN LIVE</a> at the <a href=\"https://uscn.uk\" class=\"text-black\">UK SAFETY CAMERA NETWORK LTD</a></b></h2>\n                                    </div>\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                        The primary goal of a Business Consultant is to guide companies toward smarter\n                                        decisions.\n                                    </p>\n                                </div>\n                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                        Get Started\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6\" mbr-if=\"showNav\">\n                            <div class=\"nav-wrapper\">\n                                <div class=\"nav-wrap\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">\n                                        Menu\n                                    </h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\"><a href=\"index.html#top\" class=\"text-black\">Home</a></li>\n                                    </ul>\n                                </div>\n                                <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">\n                                        Social\n                                    </h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\"><a href=\"https://x.com/uscnuk\" class=\"text-black\">X (Twitter)</a></li>\n                                        <li class=\"item-wrap\"><a href=\"https://www.linkedin.com/company/uksafetycameranetwork\" class=\"text-black\">Linked In</a></li>\n                                    </ul>\n                                </div>\n                                <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">Contact</h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\"><a href=\"tel:+443305204315\" class=\"text-black\">0330 520 4315</a></li><a href=\"tel:+443305204315\" class=\"text-primary\">\n                                        </a><li class=\"item-wrap\"><a href=\"mailto:info@highwatch.uscnlive.com\" class=\"text-black text-primary\">info@highwatch.uscnlive.com</a></li>\n                                    </ul>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12\" mbr-if=\"showCopy || showBorder\">\n                            <div class=\"copy-wrap\">\n                                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                <p class=\"mbr-copy mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\">\n                                    © Copyright 2026 - All Rights Reserved\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4MkvNLq4o",
          "_anchor": "footer01-e",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}