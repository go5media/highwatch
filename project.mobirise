              },
              ".title-wrapper": {
                "margin-bottom": "40px",
                ".label-wrapper": {
                  "margin-bottom": "16px",
                  ".label-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "padding": "7px 18px",
                    "box-shadow": "inset 0 10px 8px 0 @shadow_1, inset 0 -5px 10px -8px @shadow_2, 0 10px 10px -8px @shadow_2",
                    "background-color": "@labelBg",
                    ".iconfont-wrapper": {
