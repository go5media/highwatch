                    "width": "50%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -10px",
              ".item": {
                "padding": "0 10px",
                "margin-bottom": "100px",
                "&:last-child": {
                  "margin-bottom": "0"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                ".item-wrapper": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "height": "100%",
                  "padding": "32px",
                  "background-color": "@cardBg",
                  "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
                  "overflow": "hidden",
                  "@media (max-width: 992px)": {
                    "padding": "20px",
                    "display": "block"
                  },
                  ".icon-wrapper": {
                    "width": "52px",
                    "min-width": "52px",
                    "margin-right": "16px",
                    "@media (max-width: 992px)": {
                      "margin-right": "0",
                      "margin-bottom": "16px"
                    },
                    ".mbr-iconfont": {
                      "width": "52px",
                      "height": "52px",
                      "min-width": "52px",
                      "font-size": "32px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "background-color": "@iconBg",
                      "box-shadow": "inset 0 2px 10px -2px @iconShadow, 0 10px 10px -2px @iconShadow"
                    }
                  },
                  ".item-content": {
                    "width": "100%",
                    "display": "grid",
                    "grid-template-columns": ".85fr 1fr",
                    "gap": "40px",
                    "@media (max-width: 992px)": {
                      "display": "block"
                    },
                    ".card-box": {
                      "@media (max-width: 992px)": {
                        "margin-bottom": "20px"
                      },
                      ".item-title": {
                        "margin-bottom": "8px"
                      },
                      ".item-desc": {
                        "margin-bottom": "20px"
                      },
                      ".item-text": {
                        "margin-bottom": "20px"
                      },
                      ".list": {
                        "padding": "0",
                        "margin": "0",
                        "list-style-type": "none",
                        ".item-wrap": {
                          "position": "relative",
                          "padding-left": "24px",
                          "margin-bottom": "10px",
                          "&:last-child": {
                            "margin-bottom": "0"
                          },
                          "&::before": {
                            "content": "'✓'",
                            "position": "absolute",
                            "top": "0",
                            "left": "0",
                            "font-size": "inherit",
                            "color": "@marker",
                            "display": "inline-flex"
                          }
                        }
                      },
                      ".mbr-section-btn": {
                        "margin-top": "10px",
                        ".btn": {
                          "margin-bottom": "0"
                        }
                      }
                    },
                    ".item-img": {
                      "position": "relative",
                      "width": "100%",
                      "height": "100%",
                      "@media (max-width: 992px)": {
                        "height": "320px"
                      },
                      "img": {
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "height": "100%",
                        "width": "100%",
                        "object-fit": "cover"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#0f172a"
            },
            ".item-desc": {
              "color": "#0f172a"
            },
            ".item-text": {
              "color": "#475569"
            },
            ".list": {
              "color": "#475569"
            }
          },
          "_name": "features02",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 launchm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showCardIcon\" checked>\n        <input type=\"color\" title=\"Icon Bg\" value=\"#5480c1\" name=\"iconBg\" condition=\"showCardIcon\" selected>\n        <input type=\"color\" title=\"Icon Shadow\" value=\"#cccccc\" name=\"iconShadow\" condition=\"showCardIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\">\n        <input type=\"checkbox\" title=\"List\" name=\"showList\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#059669\" name=\"marker\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-more-vertical mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Commerce Accelerator\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Making Communities Safer</b></h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Through free CCTV installation, ongoing maintenance and professional live monitoring, USCN High Watch helps protect high streets, public spaces and local communities. We work with businesses and property owners to provide community safety cameras in locations where they can make a meaningful difference.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"items-wrapper\">\n                        <div class=\"item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-users mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                </div>\n                                <div class=\"item-content\">\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\"><b>What is High Watch Community?</b></h4>\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">High Watch is a community safety initiative operated by USCN Live, combining our free community camera hosting programme with professional live CCTV monitoring.\n<br>\n<br>Through High Watch Community Programme, eligible businesses can host a USCN-owned CCTV camera at no installation or maintenance cost. In return, we ask for a suitable mounting location and access to a small amount of electricity and internet connectivity.\n<br>\n<br>Unlike our standard Host a Camera programme, High Watch Community Programme cameras can also be monitored by our control room operators during USCN Live's operational hours, helping us identify potential incidents and contact the appropriate people or emergency services when necessary.</p>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                            A strong ecommerce foundation starts with technical stability, clear product\n                                            presentation, and a smooth user experience.\n                                        </p>\n                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showList\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                            <li class=\"item-wrap\">Optimize website speed</li>\n                                            <li class=\"item-wrap\">Improve product pages</li>\n                                            <li class=\"item-wrap\">Set up essential trust signals</li>\n                                            <li class=\"item-wrap\">Implement analytics tools to track user behavior</li>\n                                        </ul>\n                                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                                View More\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-img\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/ptzcam1-614x499.jpg\" alt=\"PTZ Camera\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-preview mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                </div>\n                                <div class=\"item-content\">\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\"><b>How does it work?</b></h4>\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">USCN installs, owns and maintains the camera, including software updates and equipment replacement when required.\n<br>\n<br>Our operators can view the live camera feed during monitoring hours, while recordings are managed by USCN in accordance with our applicable data protection procedures.</p>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                            By using strategic marketing channels and focusing on the right audiences,\n                                            you\n                                            increase visibility, attract new customers.\n                                        </p>\n                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showList\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                            <li class=\"item-wrap\">Launch SEO improvements</li>\n                                            <li class=\"item-wrap\">Run targeted paid ads across Google</li>\n                                            <li class=\"item-wrap\">Develop social media presence</li>\n                                            <li class=\"item-wrap\">Set up automated email flows</li>\n                                        </ul>\n                                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                                View More\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-img\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/20261013-170117-904x503.jpg\" alt=\"Dome Camera\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-globe-2 mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                </div>\n                                <div class=\"item-content\">\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\"><b>Can my business join?</b></h4>\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">Businesses within our service areas are welcome to apply for High Watch Community Programme.\n<br>\n<br>However, acceptance is not guaranteed. Each application is assessed individually, taking into account community safety needs, privacy considerations, location suitability and available monitoring capacity.\n<br>\n<br>If we're unable to offer High Watch Community Programme at your location, we may be able to offer an alternative through our standard Host a Camera programme.\n<br>\n<br>This provides many of the same benefits, including free camera installation and ongoing maintenance, but without routine live monitoring.</p>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                            Scaling requires optimizing logistics, automation, and data-driven\n                                            decision-making. This step ensures your business can handle more orders\n                                            while\n                                            keeping costs low and customers satisfied.\n                                        </p>\n                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showList\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                            <li class=\"item-wrap\">Streamline inventory and fulfillment,</li>\n                                            <li class=\"item-wrap\">Implement advanced reporting</li>\n                                            <li class=\"item-wrap\">Improve customer retention with loyalty</li>\n                                            <li class=\"item-wrap\">Introduce automation to reduce manual work</li>\n                                        </ul>\n                                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                                View More\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-img\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/20250726-1911280-672x378.jpg\" alt=\"Bullet Camera\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div><div class=\"item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-globe-2 mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                </div>\n                                <div class=\"item-content\">\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\"><b>Supporting Safer Communities</b></h4>\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">High Watch Community Programme is part of our commitment to making community safety technology more accessible.\n<br>\n<br>By combining community camera infrastructure with the capabilities of our USCN Live control room, we aim to provide additional protection in locations where active monitoring can offer a meaningful public-safety benefit.</p>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                            Scaling requires optimizing logistics, automation, and data-driven\n                                            decision-making. This step ensures your business can handle more orders\n                                            while\n                                            keeping costs low and customers satisfied.\n                                        </p>\n                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showList\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                            <li class=\"item-wrap\">Streamline inventory and fulfillment,</li>\n                                            <li class=\"item-wrap\">Implement advanced reporting</li>\n                                            <li class=\"item-wrap\">Improve customer retention with loyalty</li>\n                                            <li class=\"item-wrap\">Introduce automation to reduce manual work</li>\n                                        </ul>\n                                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                                View More\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-img\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/screenshot-20260728-121339-gallery-613x345.jpg\" alt=\"Cameras\" data-slide-to=\"3\" data-bs-slide-to=\"4\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4Mkg2n6Yb",
          "_anchor": "features02-3",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "padding-bottom": "(@paddingBottom * 1rem)",
              "& when (@showBorder)": {
                "padding-left": "20px",
                "padding-right": "20px",
                "border-bottom": "1px solid @border",
                "@media (max-width: 425px)": {
                  "padding-left": "0",
                  "padding-right": "0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px solid @border",
                  "pointer-events": "none",
                  "@media (max-width: 425px)": {
                    "display": "none"
                  }
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "right": "0"
                }
              },
              ".title-wrapper": {
                "margin-bottom": "40px",
                ".label-wrapper": {
                  "margin-bottom": "16px",
                  ".label-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "padding": "7px 18px",
                    "box-shadow": "inset 0 10px 8px 0 @shadow_1, inset 0 -5px 10px -8px @shadow_2, 0 10px 10px -8px @shadow_2",
                    "background-color": "@labelBg",
                    ".iconfont-wrapper": {
                      "display": "inline-flex",
                      ".mbr-iconfont": {
                        "font-size": "18px",
                        "display": "inline-flex",
                        "margin-right": "8px"
                      }
                    },
                    ".mbr-label": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "16px"
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "50%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -10px",
              ".item": {
                "padding": "0 10px",
                "margin-bottom": "20px",
                "@media (max-width: 992px)": {
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                "&:hover, &:focus": {
                  ".item-wrapper": {
                    "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 1px 10px 20px -5px @activeColor",
                    "transform": "translateY(-3px)",
                    ".item-img": {
                      "&::before": {
                        "opacity": ".4"
                      },
                      "&::after": {
                        "opacity": ".1"
                      }
                    },
                    ".item-title": {
                      "color": "@activeColor"
                    }
                  }
                },
                ".item-wrapper": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "height": "100%",
                  "padding": "24px",
                  "background-color": "@cardBg",
                  "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
                  "overflow": "hidden",
                  "transition": "all .3s ease",
                  "@media (max-width: 992px)": {
                    "padding": "20px"
                  },
                  ".item-img": {
                    "margin-bottom": "20px",
                    "position": "relative",
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "box-shadow": "inset 0 5px 15px 0 @cardBg, inset 0 -10px 15px 0 @cardBg",
                      "transition": "all .3s ease",
                      "pointer-events": "none",
                      "z-index": "1",
                      "opacity": "0"
                    },
                    "&::after": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@cardShadow_1",
                      "opacity": "0",
                      "transition": "all .3s ease",
                      "pointer-events": "none",
                      "z-index": "1"
                    },
                    "img": {
                      "height": "280px",
                      "width": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "320px"
                      }
                    }
                  },
                  ".item-date": {
                    "margin-bottom": "8px"
                  },
                  ".item-title": {
                    "margin-bottom": "0",
                    "transition": "all .3s ease"
                  },
                  ".item-text": {
                    "margin-bottom": "0",
                    "margin-top": "12px"
                  },
                  ".mbr-section-btn": {
                    "margin-top": "10px",
                    ".btn": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".item-date": {
              "color": "#334155"
            },
            ".item-title": {
              "color": "#0f172a"
            },
            ".item-text": {
              "color": "#475569"
            }
          },
          "_name": "features03",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 launchm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Date\" name=\"showDate\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <input type=\"color\" title=\"Active Color\" value=\"#5480c1\" name=\"activeColor\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-calendar mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Ecommerce Events\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Supporting Safer Communities</b></h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                From free CCTV installation and maintenance to professional live monitoring, USCN High Watch brings together the equipment and expertise needed to help protect our communities.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\">\n                        <div class=\"col-12 col-lg-6 item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-content\">\n                                    <div class=\"item-img card-wrap little-radius\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/20261013-170106-672x601.jpg\" alt=\"Dome Camera On Wall\">\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\">\n                                        April 18, 2030\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">CCTV Installation</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        USCN High Watch provides eligible locations with free community safety CCTV cameras, including installation, ongoing maintenance and equipment replacement. All cameras remain owned and operated by UK Safety Camera Network Ltd, helping businesses and property owners contribute to safer public spaces without the cost of purchasing or maintaining the equipment.\n                                    </p>\n                                    <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 item features-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-content\">\n                                    <div class=\"item-img card-wrap little-radius\">\n                                        <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/ptzcam1-1440x1171.jpg\" alt=\"PTZ Camera\">\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-4\" data-app-selector=\".item-date\">\n                                        May 21, 2030\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                                        Live Control Room<br></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                        Our professional control room operators monitor High Watch cameras during USCN Live's operating hours, helping identify suspicious activity and potential incidents in public areas. Where appropriate, operators can coordinate responses with police, emergency services or other relevant contacts, providing an additional level of support for community safety.\n                                    </p>\n                                    <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v4MkjEuQY1",
          "_anchor": "features03-4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "padding-bottom": "(@paddingBottom * 1rem)",
              "& when (@showBorder)": {
                "padding-left": "20px",
                "padding-right": "20px",
                "border-bottom": "1px solid @border",
                "@media (max-width: 425px)": {
                  "padding-left": "0",
                  "padding-right": "0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px solid @border",
                  "pointer-events": "none",
                  "@media (max-width: 425px)": {
                    "display": "none"
                  }
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "right": "0"
                }
              },
              ".card-wrapper": {
                "padding": "32px",
                "background-color": "@cardBg",
                "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, inset 0 -5px 10px -4px @cardShadow_2, 0 10px 10px -5px @cardShadow_2",
                "overflow": "hidden",
                "@media (max-width: 992px)": {
                  "padding": "24px"
                },
                ".title-wrapper": {
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  },
                  ".mbr-section-title": {
                    "margin-bottom": "16px"
                  },
                  ".text-wrapper": {
                    ".mbr-text": {
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      }
                    }
                  },
                  ".mbr-section-btn": {
                    "margin-top": "10px"
                  }
                },
                ".image-wrapper": {
                  "img": {
                    "height": "400px",
                    "width": "100%",
                    "object-fit": "cover",
                    "@media (max-width: 992px)": {
                      "height": "450px"
                    }
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -20px",
              ".card": {
                "padding": "0 20px"
              }
            },
            ".mbr-section-title": {
              "color": "#0f172a"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569"
            }
          },
          "_name": "article02",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02 launchm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"Container BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"card-wrapper\">\n                        <div class=\"row items-wrapper\">\n                            <div class=\"col-12 col-lg-6 card\">\n                                <div class=\"title-wrapper\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Why Community CCTV Monitoring Matters</b></h2>\n                                    <div class=\"text-wrapper\">\n                                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                            CCTV can play an important role in improving public safety, but installing and monitoring cameras can be expensive. USCN High Watch helps address this by providing eligible locations with free community safety cameras and professional live monitoring. Our operators can identify potential incidents and coordinate appropriate responses, helping support safer high streets, public spaces and local communities.\n                                        </p>\n                                    </div>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-black\" href=\"index.html#form01-b\" data-app-placeholder=\"Type Text\">Reach Out</a></div>\n                                </div>\n                            </div>\n                            <div class=\"col-12 col-lg-6 card\">\n                                <div class=\"image-wrapper\">\n                                    <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/screenshot-20260728-121339-gallery-613x345.jpg\" alt=\"Cameras On House\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
